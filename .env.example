# 护院鹅 · 环境变量示例
#
# 使用方法：
#   1. 复制本文件为 .env
#   2. 填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   3. 或直接在系统中设置同名环境变量
#
# 未配置时，Qwen 认知层自动关闭，系统降级为规则版（功能不受影响，告警决策依然准确）。

# ---- DashScope / 百炼 API Key ----
# 获取地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=sk-your-key-here

# ---- DashScope 服务端点（可选） ----
# 标准 Key（sk- 开头）用公共端点：
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 工作空间专属 Key（sk-ws- 开头）需改为工作空间端点，格式如下：
#   https://<workspace-id>.<region>.maas.aliyuncs.com/compatible-mode/v1
# 示例：
#   DASHSCOPE_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---- 模型名称（可选，默认 qwen-plus） ----
DASHSCOPE_MODEL=qwen-plus
